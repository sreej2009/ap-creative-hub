# ─────────────────────────────────────────────────────────────────────
# A&P Creative Hub — server configuration
# Copy to server/.env and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas connection string (replica set → transactions supported).
# For local development without Atlas run `npm run db:local` and use:
#   MONGODB_URI=mongodb://127.0.0.1:27017/ap-creative-hub?replicaSet=local
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ap-creative-hub?retryWrites=true&w=majority
# auto = detect replica set; off = force the non-transactional fallback
MONGODB_TRANSACTIONS=auto

# Public storefront URL (used in email links)
APP_URL=http://localhost:5173
# Only needed if the client is served from a DIFFERENT origin than the API (comma-separated)
CORS_ORIGINS=
# Number of reverse proxies in front of the app (Render/Railway/Nginx usually 1)
TRUST_PROXY=0
# Serve the built client from Express (recommended for single-service deployments)
SERVE_CLIENT=false
CLIENT_DIST_DIR=../client/dist

# Long random secret (≥ 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Cookies: set COOKIE_SECURE=true in production (HTTPS). Use COOKIE_SAMESITE=none
# only if the client and API are on different sites (requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CUSTOMER_SESSION_DAYS=30
ADMIN_SESSION_HOURS=12

# Cloudinary (product images). Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ap-creative-hub

# Razorpay — start with TEST keys (rzp_test_…). Live keys are refused
# unless RAZORPAY_ALLOW_LIVE=true is set after the owner approves go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=false

# Transactional email via any SMTP provider (Brevo, Amazon SES, Postmark, Resend SMTP…).
# Leave SMTP_HOST empty to disable — notifications are then logged as "skipped".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="A&P Creative Hub <orders@example.com>"

STORE_NAME=A&P Creative Hub
# Minutes stock stays reserved for an unpaid online order
RESERVATION_MINUTES=30
# Run background jobs (reservation expiry, image cleanup) in this process
RUN_JOBS=true
